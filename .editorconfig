root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.cs]
indent_size = 4

# Code style. backend/Directory.Build.props sets EnforceCodeStyleInBuild, so
# every rule set to warning here fails `dotnet build` (warnings are errors)
# as well as `dotnet format --verify-no-changes`.

# Whitespace and layout, as `dotnet format` applies it.
dotnet_diagnostic.IDE0055.severity = warning

# One namespace per file, declared without braces.
csharp_style_namespace_declarations = file_scoped
dotnet_diagnostic.IDE0161.severity = warning

# Unused using directives.
dotnet_diagnostic.IDE0005.severity = warning
dotnet_sort_system_directives_first = true

# Braces on every if, else, for, foreach, while and using body.
csharp_prefer_braces = true
dotnet_diagnostic.IDE0011.severity = warning

# Accessibility is written out rather than left to the default.
dotnet_style_require_accessibility_modifiers = for_non_interface_members
dotnet_diagnostic.IDE0040.severity = warning

[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
