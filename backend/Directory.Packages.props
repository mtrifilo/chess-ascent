<!--
  LEARN: Central Package Management. Every NuGet package version used by any
  project in this folder is declared here once, and project files reference
  packages by name only. This is Maven's dependencyManagement section, except
  that it is enforced: a version written in a project file fails the build.
-->
<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!--
      NuGet otherwise lets a project pin its own version with VersionOverride,
      which would bring back per-project versions.
    -->
    <CentralPackageVersionOverrideEnabled>false</CentralPackageVersionOverrideEnabled>
  </PropertyGroup>

  <ItemGroup Label="Chess rules">
    <!--
      Referenced only by ChessAscent.Chess, behind its own interface.
      ChessAscent.Chess.Tests checks that no other project references it.
      The brackets pin exactly 1.2.0; a bare version in NuGet means "1.2.0 or
      later".
    -->
    <PackageVersion Include="ChessRealms.Engine" Version="[1.2.0]" />
  </ItemGroup>

  <ItemGroup Label="API description">
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.ApiDescription.Server" Version="11.0.0" />
    <PackageVersion Include="Scalar.AspNetCore" Version="3.3.0" />
  </ItemGroup>

  <ItemGroup Label="Accounts">
    <PackageVersion Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="11.0.0" />
  </ItemGroup>

  <ItemGroup Label="Database">
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="11.0.0" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="11.0.0" />
  </ItemGroup>

  <ItemGroup Label="Tests">
    <PackageVersion Include="AwesomeAssertions" Version="9.6.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="11.0.0" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.17.0" />
    <PackageVersion Include="xunit.v3" Version="4.0.3" />
  </ItemGroup>

</Project>
