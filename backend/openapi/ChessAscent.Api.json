    },
    "/health/ready": {
      "get": {
        "summary": "Whether the API is ready to serve: every readiness check passes.",
        "responses": {
          "200": {
            "description": "The overall status is Healthy or Degraded.",
            "content": {
              "text/plain": {
                "schema": {
                  "enum": [
                    "Healthy",
                    "Degraded"
                  ],
                  "type": "string"
                }
              }
            }
          },
          "503": {
            "description": "The overall status is Unhealthy.",
            "content": {
              "text/plain": {
                "schema": {
                  "enum": [
                    "Unhealthy"
                  ],
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AppVersionResponse": {
        "required": [
          "version",
          "commit"
        ],
        "type": "object",
        "properties": {
          "version": {
            "type": "string",
            "description": "The application version, such as `0.1.0`."
          },
          "commit": {
            "type": [
              "null",
              "string"
            ],
            "description": "The git commit checked out when the API was built, or `null` when the\nbuild had no git metadata to read (for example, a source archive). It does\nnot show whether the working tree had uncommitted changes."
          }
        },
        "description": "The body of `GET /version`."
      },
      "CreateGameRequest": {
        "required": [
          "playerSide",
          "opponent"
        ],
        "type": "object",
        "properties": {
          "playerSide": {
            "description": "The side the signed-in player has.",
            "$ref": "#/components/schemas/Side"
          },
          "opponent": {
            "description": "Who plays the other side.",
            "$ref": "#/components/schemas/OpponentRequest"
          }
        },
        "description": "The body of `POST /games`."
      },
      "CurrentUserResponse": {
        "required": [
          "email"
        ],
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "description": "The account's email address, as it was registered."
          }
        },
        "description": "The account that is signed in."
      },
      "GameEndReason": {
        "enum": [
          "checkmate",
          "stalemate",
          "threefoldRepetition",
          "fiftyMoveRule",
          "deadPosition",
          "resignation"
        ]
      },
      "GameListResponse": {
        "required": [
          "games",
          "nextCursor"
        ],
        "type": "object",
        "properties": {
          "games": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/GameSummaryResponse"
            },
            "description": "The games, most recent activity first. Games with the same last activity\ntime are in the same order on every request."
          },
          "nextCursor": {
            "type": [
              "null",
              "string"
            ],
            "description": "Where the next page starts: send it back unchanged as `cursor`, with\nthe same `status`, for the next page. `null` when there are no\nmore games. The next page holds the games after this page's last one as\nthe list stands when it is asked for: a game that has had a move since\nis at the top of the list instead, where reading the list again finds it,\nand no game is listed on two pages while the server's clock runs forward."
          }
        },
        "description": "One page of the signed-in player's games, most recent activity first."
      },
      "GameProgress": {
        "enum": [
          "ongoing",
          "finished"
        ],
        "description": "Whether a game is still being played."
      },
      "GameResponse": {
        "required": [
          "id",
          "playerSide",
          "opponent",
          "fen",
          "sideToMove",
          "status",
          "result",
          "endReason",
          "moves",
          "legalMoves",
          "promotions",
          "hintCount"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "The game's id.",
            "format": "uuid"
          },
          "playerSide": {
            "description": "The side the signed-in player has.",
            "$ref": "#/components/schemas/Side"
          },
          "opponent": {
            "description": "Who plays the other side.",
            "$ref": "#/components/schemas/OpponentResponse"
          },
          "fen": {
            "type": "string",
            "description": "The current position as six-field FEN."
          },
          "sideToMove": {
            "description": "The side whose turn it is. After checkmate, the side that was mated.",
            "$ref": "#/components/schemas/Side"
          },
          "status": {
            "description": "Whether the game is still being played.",
            "$ref": "#/components/schemas/GameProgress"
          },
          "result": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "description": "How the game ended; `null` while it is ongoing.",
                "$ref": "#/components/schemas/GameResult"
              }
            ]
          },
          "endReason": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "description": "Why the game ended; `null` while it is ongoing.",
                "$ref": "#/components/schemas/GameEndReason"
              }
            ]
          },
          "moves": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MoveResponse"
            },
            "description": "The moves played so far, oldest first."
          },
          "legalMoves": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "description": "The squares each piece of the side to move can go to, keyed by the\nsquare it stands on, such as `{ \"g1\": [\"f3\", \"h3\"] }`. A piece with\nno legal move has no key. A castling move is listed as the king's\ndestination. Empty once the game is over."
          },
          "promotions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PromotionResponse"
            },
            "description": "The moves in LegalMoves that promote a pawn, each with\nthe pieces it may become. Such a move is sent with the piece's letter.\nEmpty when there are none, and once the game is over."
          },
          "hintCount": {
            "type": "integer",
            "description": "The number of positions in which the player was given a hint. Asking\nagain in the same position does not add to it. Above 0, the game is one\nin which a hint was used.",
            "format": "int32"
          }
        },
        "description": "A game as the game screen shows it."
      },
      "GameResult": {
        "enum": [
          "whiteWins",
          "blackWins",
          "draw"
        ]
      },
      "GameSummaryResponse": {
        "required": [
          "id",
          "playerSide",
          "opponent",
          "status",
          "result",
          "endReason",
          "halfMoveCount",
          "hintCount",
          "lastActivityAt"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "The game's id.",
            "format": "uuid"
          },
          "playerSide": {
            "description": "The side the signed-in player has.",
            "$ref": "#/components/schemas/Side"
          },
          "opponent": {
            "description": "Who plays the other side.",
            "$ref": "#/components/schemas/OpponentResponse"
          },
          "status": {
            "description": "Whether the game is still being played.",
            "$ref": "#/components/schemas/GameProgress"
          },
          "result": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "description": "How the game ended; `null` while it is ongoing.",
                "$ref": "#/components/schemas/GameResult"
              }
            ]
          },
          "endReason": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "description": "Why the game ended; `null` while it is ongoing.",
                "$ref": "#/components/schemas/GameEndReason"
              }
            ]
          },
          "halfMoveCount": {
            "type": "integer",
            "description": "The number of half-moves played so far, by both sides: the number of\nmoves the game's own response lists.",
            "format": "int32"
          },
          "hintCount": {
            "type": "integer",
            "description": "The number of positions in which the player was given a hint, as the\ngame's own response gives it. Above 0, the game is one in which a hint was\nused.",
            "format": "int32"
          },
          "lastActivityAt": {
            "type": "string",
            "description": "When the game was created or last had a move saved, as an ISO 8601 time\nin UTC.",
            "format": "date-time"
          }
        },
        "description": "A game as the list of games shows it, without its moves."
      },
      "HintRequest": {
        "required": [
          "halfMoveNumber"
        ],
        "type": "object",
        "properties": {
          "halfMoveNumber": {
            "type": "integer",
            "description": "The half-move number the hinted move would have, as a move request gives\nit: one more than the number of moves in the game the client is showing.\nAny other number is refused with 409 before a hint is looked for, so a\nhint always belongs to the position the client is showing.",
            "format": "int32"
          }
        },
        "description": "The body of `POST /games/{id}/hints`."
      },
      "HintResponse": {
        "required": [
          "from",
          "to"
        ],
        "type": "object",
        "properties": {
          "from": {
            "type": "string",
            "description": "The square of the piece to move, such as `b1`."
          },
          "to": {
            "type": "string",
            "description": "The square it moves to, such as `d2`. A castling move is given as the\nking's move. A move that promotes a pawn is given by its two squares only."
          }
        },
        "description": "The hint: the move the hint engine finds best for the player, which is\nnot played."
      },
      "HttpValidationProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          },
          "errors": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      },
      "MoveResponse": {
        "required": [
          "halfMoveNumber",
          "uci",
          "san"
        ],
        "type": "object",
        "properties": {
          "halfMoveNumber": {
            "type": "integer",
            "description": "The move's place in the game, from 1 for the first move played, whichever\nside made it. It is not the FEN's move number.",
            "format": "int32"
          },
          "uci": {
            "type": "string",
            "description": "The move in UCI coordinate form, such as `e2e4` or `e7e8q`."
          },
          "san": {
            "type": "string",
            "description": "The move in standard algebraic notation, such as `e4` or `e8=Q+`."
          }
        },
        "description": "A move that has been played."
      },
      "OpponentKind": {
        "enum": [
          "none",
          "computer"
        ],
        "description": "Who plays the side the player does not."
      },
      "OpponentRequest": {
        "required": [
          "kind"
        ],
        "type": "object",
        "properties": {
          "kind": {
            "description": "The kind of opponent: `computer`, or `none` when the signed-in\nplayer moves both sides.",
            "$ref": "#/components/schemas/OpponentKind"
          },
          "strength": {
            "type": [
              "null",
              "integer"
            ],
            "description": "The computer's strength: 600, 800, 1000, 1200 or 1400, where higher is\nstronger. Left out or `null`, it is 800. Any other number is refused\nwith 400, as is a strength given when the kind is `none`.",
            "format": "int32"
          }
        },
        "description": "Who plays the side the player does not."
      },
      "OpponentResponse": {
        "required": [
          "kind",
          "strength"
        ],
        "type": "object",
        "properties": {
          "kind": {
            "description": "The kind of opponent.",
            "$ref": "#/components/schemas/OpponentKind"
          },
          "strength": {
            "type": [
              "null",
              "integer"
            ],
            "description": "The computer's strength setting; `null` when the kind is `none`.",
            "format": "int32"
          }
        },
        "description": "Who plays the side the player does not."
      },
      "PlayMoveRequest": {
        "required": [
          "uci",
          "halfMoveNumber"
        ],
        "type": "object",
        "properties": {
          "uci": {
            "maxLength": 5,
            "type": "string",
            "description": "The move in UCI coordinate form: the square the piece leaves and the\nsquare it arrives on, in lower case, such as `e2e4`, and for a\npromotion the piece's letter, as in `e7e8q`. A promotion needs its\nletter. Castling is the king's move, such as `e1g1`."
          },
          "halfMoveNumber": {
            "type": "integer",
            "description": "The half-move number this move is meant to have, numbered as the\nresponse's moves are: one more than the number of moves in the game the\nclient is showing. Any other number, whether the game has moved on since\nor the number is simply wrong, is refused with 409 before the move is\nplayed, and nothing is saved, so sending the same move again is always\nsafe.",
            "format": "int32"
          }
        },
        "description": "The body of `POST /games/{id}/moves`."
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "PromotionPiece": {
        "enum": [
          "queen",
          "rook",
          "bishop",
          "knight"
        ],
        "description": "The piece a pawn becomes when it reaches the last rank."
      },
      "PromotionResponse": {
        "required": [
          "from",
          "to",
          "pieces"
        ],
        "type": "object",
        "properties": {
          "from": {
            "type": "string",
            "description": "The square the pawn leaves."
          },
          "to": {
            "type": "string",
            "description": "The square it arrives on."
          },
          "pieces": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PromotionPiece"
            },
            "description": "The pieces it may become, in the order queen, rook, bishop, knight. The\nUCI letters are `q`, `r`, `b` and `n`."
          }
        },
        "description": "A pawn move to the last rank, which needs the piece the pawn becomes."
      },
      "RegisterRequest": {
        "required": [
          "email",
          "password"
        ],
        "type": "object",
        "properties": {
          "email": {
            "maxLength": 256,
            "type": "string",
            "description": "The new account's email address, which is also what the player signs in\nwith. Compared without regard to case."
          },
          "password": {
            "type": "string",
            "description": "The new account's password. The response names any rule it breaks."
          }
        },
        "description": "The body of `POST /auth/register`."
      },
      "Side": {
        "enum": [
          "white",
          "black"
        ],
        "description": "One of the two players."
      },
      "SignInRequest": {
        "required": [
          "email",
          "password"
        ],
        "type": "object",
        "properties": {
          "email": {
            "maxLength": 256,
            "type": "string",
            "description": "The account's email address, in any case."
          },
          "password": {
            "type": "string",
            "description": "The account's password."
          }
        },
        "description": "The body of `POST /auth/sign-in`."
      }
    }
  },
  "tags": [
    {
      "name": "AccountEndpoints"
    },
    {
      "name": "ChessAscent.Api"
    },
    {
      "name": "GameEndpoints"
    }
  ]
}
