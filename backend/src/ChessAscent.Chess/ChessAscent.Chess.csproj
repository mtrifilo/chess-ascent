<!--
  The chess domain. It must not reference ASP.NET Core, EF Core or any other
  web or database package, so the rules can be tested and replaced on their
  own. The target below fails the build on such a reference, and
  ChessAscent.Chess.Tests checks that the compiled code uses none.
-->
<Project Sdk="Microsoft.NET.Sdk">

  <!--
    LEARN: A target is a named build step, the counterpart of a Maven plugin
    execution bound to a phase. BeforeTargets hooks it into the SDK's own
    steps; here it runs before the SDK resolves package and framework
    references, so a forbidden one fails the build at once.
  -->
  <Target Name="ForbidWebAndDatabaseReferences" BeforeTargets="CollectPackageReferences;ResolveFrameworkReferences">
    <ItemGroup>
      <_ForbiddenReference Include="@(PackageReference);@(FrameworkReference)"
                           Condition="$([System.String]::new('%(Identity)').ToLowerInvariant().StartsWith('microsoft.aspnetcore'))
                                      or $([System.String]::new('%(Identity)').ToLowerInvariant().StartsWith('microsoft.entityframeworkcore'))
                                      or $([System.String]::new('%(Identity)').ToLowerInvariant().StartsWith('npgsql'))" />
      <_ForbiddenReference Include="@(ProjectReference)" Condition="'%(Filename)' == 'ChessAscent.Api'" />
    </ItemGroup>
    <Error Condition="'@(_ForbiddenReference)' != ''"
           Text="ChessAscent.Chess must not reference web or database code: @(_ForbiddenReference)" />
  </Target>

</Project>
