<!--
  LEARN: A project file is the C# counterpart of a pom.xml, but much shorter,
  for three reasons. Source files are picked up by folder: every .cs file
  under this directory is compiled, so nothing lists them. The Sdk attribute
  imports a whole build definition: Microsoft.NET.Sdk.Web is the plain SDK
  plus ASP.NET Core, roughly what the Spring Boot parent and its web starter
  give a Maven build. And shared settings (target framework, nullable,
  analyzers) come from Directory.Build.props one folder up.

  MSBuild has no fixed lifecycle like Maven's validate, compile, test,
  package. It has targets (Restore, Build, Publish) that declare what they
  depend on, and the dotnet commands run them. Output lands in bin/ and obj/
  next to this file rather than in a single target/ folder.
-->
<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    Build-time OpenAPI generation (Microsoft.Extensions.ApiDescription.Server)
    runs only when scripts/gen-api-types.sh asks for it, so an ordinary build
    never starts the application. The script copies the document to
    backend/openapi/ChessAscent.Api.json, which is committed: a change to the
    API contract shows in review as a change to that file.

    The generator takes its OpenAPI version from its own command line, not
    from the OpenApiVersion set in ApiDocumentServices (which the document
    served at run time uses), so 3.1 is pinned in both places.
  -->
  <PropertyGroup>
    <OpenApiGenerateDocumentsOnBuild>false</OpenApiGenerateDocumentsOnBuild>
    <OpenApiGenerateDocumentsOptions>--openapi-version OpenApi3_1</OpenApiGenerateDocumentsOptions>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <!-- A build tool only: nothing from it ships with the application. -->
    <PackageReference Include="Microsoft.Extensions.ApiDescription.Server">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Scalar.AspNetCore" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <!--
      The design-time services that `dotnet ef` loads to create migrations.
      PrivateAssets keeps them out of the published application and out of
      any project that references this one.
    -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!--
    Writes the version and the git commit into the assembly as two named
    [AssemblyMetadata] attributes, which GET /version reads back. The SDK
    fills SourceRevisionId from the git repository during
    InitializeSourceControlInformation and leaves it empty when there is no
    repository, so a build from a source archive still succeeds and reports
    no commit. Pass -p:SourceRevisionId=<sha> to supply one by hand.
  -->
  <Target Name="EmbedVersionMetadata"
          BeforeTargets="GetAssemblyAttributes"
          DependsOnTargets="InitializeSourceControlInformation">
    <ItemGroup>
      <AssemblyMetadata Include="Version" Value="$(Version)" />
      <AssemblyMetadata Include="SourceRevisionId" Value="$(SourceRevisionId)" />
    </ItemGroup>
  </Target>

</Project>
