{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "EnginePool": {
    "Kinds": {
      // Maia-3, the computer opponent (Opponents/MaiaOpponent.cs), as
      // scripts/setup-maia.sh installs it. The program, working directory
      // and HF_HOME come from Opponents/MaiaInstallation.cs, because they
      // depend on where the engines directory is.
      "maia": {
        // Maia's own entry point. Isolated mode (-I) keeps the working
        // directory off Python's module path, so that no file there can
        // stand in for one of the modules Maia imports. The weights are the 5M
        // model at the revision the set-up script downloaded, read from the
        // local cache only. History on: Maia rebuilds the previous positions
        // from the moves it is sent, and chooses differently without them.
        "Arguments": [
          "-I", "-m", "maia3",
          "--model", "maia3-5m",
          "--revision", "b6559de2398d7140b985f28fd2c19fb5e47ddabe",
          "--local-files-only",
          "--device", "cpu",
          "--use-uci-history"
        ],
        // Maia seeds its random choices with 42 unless told otherwise, and
        // would then repeat the same moves after every start.
        "RandomSeedArgument": "--seed",
        // HF_HUB_OFFLINE: the Hugging Face library makes no network call.
        // OMP_NUM_THREADS: PyTorch uses one thread; a move takes about 10 ms
        // either way, and more threads only compete with the API.
        "SetEnvironment": {
          "HF_HUB_OFFLINE": "1",
          "OMP_NUM_THREADS": "1"
        },
        "Processes": 1,
        // Measured on an Apple M5: the handshake (Python and PyTorch
        // starting, then the model loading on the first isready) took 0.5 s
        // warm and 7 s on the first start after installing; a move takes
        // 7 to 9 ms, 70 ms at worst; an option is set at once; quit exits in
        // about 0.2 s. Each wait leaves ample room for a slower machine.
        "HandshakeTimeout": "00:01:00",
        "ReadyTimeout": "00:00:05",
        "SearchTimeout": "00:00:05",
        "StopTimeout": "00:00:02",
        "ExitTimeout": "00:00:02",
        "CheckOutTimeout": "00:00:10",
        "StartAttempts": 3,
        "RestartDelay": "00:00:02"
      }
    }
  }
}
