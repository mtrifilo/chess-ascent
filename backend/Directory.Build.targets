<!--
  LEARN: Directory.Build.targets is the second half of the parent-POM idea
  in Directory.Build.props, and the difference between the two is when
  MSBuild reads them. A project file is not read top to bottom on its own:
  the SDK wraps it, importing Directory.Build.props near the very start,
  then the .props files of the NuGet packages the project uses, then the
  project's own contents, then the packages' .targets files, and
  Directory.Build.targets near the very end. Properties and items are
  evaluated in that order, so props is the place for defaults a project or
  package may override, and targets is the place for the last word: here,
  removing an item that a package's .props file adds, which a
  Directory.Build.props would try to remove before it exists. A Maven
  parent POM has no counterpart that applies after the child POM. The
  nearest-file rule described in Directory.Build.props applies here too.
-->
<Project>

  <ItemGroup>
    <!--
      xunit.v3 depends on Microsoft.Testing.Extensions.Telemetry, which sends
      usage data to Microsoft from every test run that dotnet test starts,
      unless the person running it has set an opt-out variable. The package
      registers itself by adding this item, under this identifier, from its
      .props file. Microsoft.Testing.Platform.MSBuild writes the items into a
      generated SelfRegisteredExtensions.cs, which the test executable runs
      at start-up; without the item, nothing in the executable calls the
      extension.
    -->
    <TestingPlatformBuilderHook Remove="98058041-B5B6-4A75-9834-58E6DF796A22" />
  </ItemGroup>

  <!--
    The target RefuseTestingPlatformTelemetry in Directory.Build.props fails
    the build if a hook with the extension's display name is still
    registered.
  -->

</Project>
